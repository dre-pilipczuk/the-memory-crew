---
/**
 * Site header — wordmark, primary nav (with dropdowns), contact CTA, mobile menu.
 */
import Container from '../common/Container.astro';
import Wordmark from '../common/Wordmark.astro';
import Button from '../common/Button.astro';
import { site } from '../../config/site';
import { primaryNav, primaryCta, isNavGroup } from '../../config/navigation';
import { withBase } from '../../config/routes';

const navId = 'primary-navigation';
---

<header class="navbar">
	<Container>
		<div class="navbar__bar">
			<div class="navbar__brand">
				<Wordmark size="sm" />
				<p class="navbar__area">{site.serviceAreaLabel}</p>
			</div>

			<button
				class="navbar__toggle"
				type="button"
				aria-expanded="false"
				aria-controls={navId}
				data-nav-toggle
			>
				<span class="navbar__toggle-label">Menu</span>
				<span class="navbar__toggle-icon" aria-hidden="true"></span>
			</button>

			<nav class="navbar__nav" id={navId} data-nav-panel aria-label="Primary">
				<ul class="navbar__list">
					{
						primaryNav
							.filter((item) => item.label !== primaryCta.label)
							.map((item) =>
								isNavGroup(item) ? (
									<li class="navbar__item navbar__item--has-children">
										<a class="navbar__link" href={withBase(item.href)}>
											{item.label}
											<span class="navbar__caret" aria-hidden="true" />
										</a>
										<ul class="navbar__dropdown">
											<li>
												<a class="navbar__dropdown-link" href={withBase(item.href)}>
													All {item.label.toLowerCase()}
												</a>
											</li>
											{item.children.map((child) => (
												<li>
													<a
														class="navbar__dropdown-link"
														href={withBase(child.href)}
													>
														{child.label}
													</a>
												</li>
											))}
										</ul>
									</li>
								) : (
									<li class="navbar__item">
										<a class="navbar__link" href={withBase(item.href)}>
											{item.label}
										</a>
									</li>
								),
							)
					}
				</ul>
				<div class="navbar__cta">
					<Button variant="primary" size="sm" href={withBase(primaryCta.href)}>
						{primaryCta.label}
					</Button>
				</div>
			</nav>
		</div>
	</Container>
</header>

<script>
	function initNav() {
		const toggle = document.querySelector('[data-nav-toggle]');
		const panel = document.querySelector('[data-nav-panel]');
		if (!(toggle instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;

		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			panel.classList.toggle('is-open', open);
			document.body.classList.toggle('nav-open', open);
		};

		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			setOpen(open);
		});

		panel.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});
	}

	initNav();
	document.addEventListener('astro:page-load', initNav);
</script>

<style>
	.navbar {
		position: sticky;
		top: 0;
		z-index: 50;
		background-color: color-mix(in srgb, var(--color-canvas) 92%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
	}

	.navbar__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-3);
		min-height: 4rem;
	}

	.navbar__brand {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.navbar__area {
		margin: 0;
		font-size: var(--text-xs);
		color: var(--color-ink-muted);
		white-space: nowrap;
	}

	.navbar__toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		color: var(--color-ink);
		cursor: pointer;
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}

	.navbar__toggle:focus-visible {
		outline: none;
		box-shadow: var(--focus-ring);
	}

	.navbar__toggle-icon {
		width: 1.1rem;
		height: 1.1rem;
		position: relative;
	}

	.navbar__toggle-icon::before,
	.navbar__toggle-icon::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		height: 2px;
		background: currentColor;
		border-radius: 1px;
		transition: transform var(--duration-fast) var(--ease-default);
	}

	.navbar__toggle-icon::before {
		top: 0.25rem;
	}

	.navbar__toggle-icon::after {
		bottom: 0.25rem;
	}

	.navbar__toggle[aria-expanded='true'] .navbar__toggle-icon::before {
		top: 0.45rem;
		transform: rotate(45deg);
	}

	.navbar__toggle[aria-expanded='true'] .navbar__toggle-icon::after {
		bottom: 0.45rem;
		transform: rotate(-45deg);
	}

	.navbar__nav {
		display: none;
		flex-direction: column;
		gap: var(--space-4);
		position: absolute;
		inset-inline: 0;
		top: 100%;
		padding: var(--space-4) var(--gutter) var(--space-5);
		background: var(--color-canvas);
		border-bottom: 1px solid var(--color-border);
		box-shadow: var(--shadow-md);
	}

	.navbar__nav.is-open {
		display: flex;
	}

	.navbar__list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
	}

	.navbar__link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-3) 0;
		color: var(--color-ink);
		text-decoration: none;
		font-size: var(--text-base);
		font-weight: var(--weight-medium);
	}

	.navbar__link:hover {
		color: var(--color-accent);
	}

	.navbar__caret {
		width: 0.4rem;
		height: 0.4rem;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(45deg);
		margin-top: -0.15rem;
	}

	.navbar__dropdown {
		list-style: none;
		margin: 0 0 var(--space-2);
		padding: 0 0 0 var(--space-3);
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		border-left: 2px solid var(--color-border);
	}

	.navbar__dropdown-link {
		display: block;
		padding: var(--space-2) 0;
		color: var(--color-ink-muted);
		text-decoration: none;
		font-size: var(--text-sm);
	}

	.navbar__dropdown-link:hover {
		color: var(--color-accent);
	}

	.navbar__cta {
		padding-top: var(--space-2);
	}

	@media (min-width: 64rem) {
		.navbar__toggle {
			display: none;
		}

		.navbar__bar {
			gap: var(--space-6);
		}

		.navbar__nav {
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: flex-end;
			flex: 1;
			position: static;
			padding: 0;
			background: transparent;
			border: none;
			box-shadow: none;
			gap: var(--space-5);
		}

		.navbar__list {
			flex-direction: row;
			align-items: center;
			gap: var(--space-1);
		}

		.navbar__item {
			position: relative;
		}

		.navbar__link {
			padding: var(--space-2) var(--space-3);
			font-size: var(--text-sm);
			border-radius: var(--radius-md);
		}

		.navbar__link:hover {
			background: var(--color-surface-muted);
			color: var(--color-ink);
		}

		.navbar__dropdown {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			min-width: 14rem;
			padding: var(--space-2);
			margin: 0;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-lg);
			background: var(--color-surface);
			box-shadow: var(--shadow-md);
			border-left: none;
			z-index: 20;
		}

		.navbar__item--has-children:hover .navbar__dropdown,
		.navbar__item--has-children:focus-within .navbar__dropdown {
			display: flex;
		}

		.navbar__dropdown-link {
			padding: var(--space-2) var(--space-3);
			border-radius: var(--radius-md);
		}

		.navbar__dropdown-link:hover {
			background: var(--color-surface-muted);
			color: var(--color-ink);
		}

		.navbar__cta {
			padding-top: 0;
		}

		.navbar__area {
			display: none;
		}
	}
</style>
