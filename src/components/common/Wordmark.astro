---
/**
 * @deprecated Prefer Logo from ../brand/Logo.astro
 * Kept as a thin alias so older imports keep working.
 */
import Logo from '../brand/Logo.astro';
import { logoVariant } from '../../config/brand';

interface Props {
	href?: string | false;
	size?: 'sm' | 'md' | 'lg';
	class?: string;
}

const { href, size = 'md', class: className } = Astro.props;
---

<Logo variant={logoVariant} href={href} size={size} class={className} />
