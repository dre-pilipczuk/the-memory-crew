---
/**
 * Typeset wordmark — temporary logo until a custom mark exists.
 */
import { site } from '../../config/site';

interface Props {
	/** Link to home when used in chrome */
	href?: string | false;
	size?: 'sm' | 'md' | 'lg';
	class?: string;
}

const {
	href = import.meta.env.BASE_URL,
	size = 'md',
	class: className,
} = Astro.props;

const classes = ['wordmark', `wordmark--${size}`, className].filter(Boolean).join(' ');
const Tag = href ? 'a' : 'span';
---

<Tag class={classes} href={href || undefined} aria-label={site.name}>
	<span class="wordmark__the">The</span>
	<span class="wordmark__name">Memory Crew</span>
</Tag>

<style>
	.wordmark {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.1em;
		font-family: var(--font-display);
		font-weight: var(--weight-semibold);
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--color-ink);
		text-decoration: none;
	}

	.wordmark:hover {
		color: var(--color-ink);
	}

	.wordmark:focus-visible {
		outline: none;
		border-radius: var(--radius-sm);
		box-shadow: var(--focus-ring);
	}

	.wordmark__the {
		font-size: 0.55em;
		font-weight: var(--weight-medium);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-ink-muted);
	}

	.wordmark--sm {
		font-size: var(--text-lg);
	}

	.wordmark--md {
		font-size: var(--text-2xl);
	}

	.wordmark--lg {
		font-size: var(--text-3xl);
	}
</style>
