---
/**
 * Optimized image with consistent 3:2 crop and placeholder fallback.
 * Accepts Astro ImageMetadata (from content collections) or remote/public src string.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src?: ImageMetadata | string;
	alt: string;
	widths?: number[];
	sizes?: string;
	loading?: 'lazy' | 'eager';
	priority?: boolean;
	class?: string;
	aspect?: '3/2' | '16/9' | '1/1';
}

const {
	src,
	alt,
	widths = [400, 600, 900, 1200],
	sizes = '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw',
	loading = 'lazy',
	priority = false,
	class: className,
	aspect = '3/2',
} = Astro.props;

const classes = ['smart-image', className].filter(Boolean).join(' ');
const isMetadata = src != null && typeof src === 'object';
---

<div class={classes} style={`--smart-aspect: ${aspect}`}>
	{
		isMetadata ? (
			<Image
				src={src}
				alt={alt}
				widths={widths}
				sizes={sizes}
				loading={priority ? 'eager' : loading}
				fetchpriority={priority ? 'high' : undefined}
				formats={['avif', 'webp']}
				class="smart-image__img"
			/>
		) : typeof src === 'string' && src ? (
			<img
				src={src}
				alt={alt}
				loading={priority ? 'eager' : loading}
				decoding="async"
				class="smart-image__img"
			/>
		) : (
			<div class="smart-image__placeholder" aria-hidden="true">
				<span>Photo coming soon</span>
			</div>
		)
	}
</div>

<style>
	.smart-image {
		width: 100%;
		aspect-ratio: var(--smart-aspect, 3 / 2);
		overflow: hidden;
		background-color: var(--color-surface-muted);
	}

	.smart-image__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.smart-image__placeholder {
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
		background: linear-gradient(
			145deg,
			var(--color-surface-muted),
			var(--color-accent-subtle)
		);
		color: var(--color-ink-subtle);
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
</style>
