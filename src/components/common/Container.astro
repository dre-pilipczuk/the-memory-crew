---
/**
 * Container — centers content with consistent gutters.
 */
interface Props {
	width?: 'content' | 'default' | 'wide';
	as?: 'div' | 'section' | 'article' | 'main' | 'header' | 'footer';
	class?: string;
}

const { width = 'default', as: Tag = 'div', class: className } = Astro.props;

const classes = ['container', `container--${width}`, className].filter(Boolean).join(' ');
---

<Tag class={classes}>
	<slot />
</Tag>

<style>
	.container {
		width: 100%;
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	.container--content {
		max-width: var(--width-content);
	}

	.container--default {
		max-width: var(--width-container);
	}

	.container--wide {
		max-width: var(--width-wide);
	}
</style>
