---
/**
 * Gallery — responsive image grid primitive (2 → 3 → 4 columns).
 * Pass items or use default slot with figure children.
 */
interface GalleryItem {
	src: string;
	alt: string;
	/** Optional caption */
	caption?: string;
}

interface Props {
	items?: GalleryItem[];
	/** columns at largest breakpoint */
	columns?: 2 | 3 | 4;
	class?: string;
}

const { items = [], columns = 3, class: className } = Astro.props;

const classes = ['gallery', `gallery--cols-${columns}`, className]
	.filter(Boolean)
	.join(' ');
---

<div class={classes} role="list">
	{
		items.length > 0
			? items.map((item) => (
					<figure class="gallery__item" role="listitem">
						<div class="gallery__frame">
							<img
								src={item.src}
								alt={item.alt}
								loading="lazy"
								decoding="async"
								width="600"
								height="400"
							/>
						</div>
						{item.caption && (
							<figcaption class="gallery__caption">{item.caption}</figcaption>
						)}
					</figure>
				))
			: (
					<slot />
				)
	}
</div>

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-4);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	@media (min-width: 40rem) {
		.gallery--cols-3,
		.gallery--cols-4 {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.gallery--cols-4 {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.gallery__item {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.gallery__frame {
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background-color: var(--color-surface-muted);
		border: 1px solid var(--color-border);
	}

	.gallery__frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.gallery__caption {
		font-size: var(--text-sm);
		color: var(--color-ink-muted);
		padding-inline: var(--space-1);
	}

	/* Slot-based children */
	.gallery :global(.gallery__item),
	.gallery :global(figure) {
		margin: 0;
	}
</style>
