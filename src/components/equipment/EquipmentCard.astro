---
/**
 * Equipment card — image placeholder, title, category, price from.
 */
import Card from '../common/Card.astro';
import type { EquipmentEntry } from '../../lib/content';
import { equipmentPath } from '../../lib/content';
import { getHireCategory } from '../../config/hire';
import { withBase } from '../../config/routes';

interface Props {
	item: EquipmentEntry;
	/** When false, card is not linked (e.g. design-system demos) */
	linked?: boolean;
	class?: string;
}

const { item, linked = true, class: className } = Astro.props;
const category = getHireCategory(item.data.category);
const href = linked ? withBase(equipmentPath(item)) : undefined;
const priceLabel =
	item.data.priceFrom != null ? `From £${item.data.priceFrom}` : 'Price on request';
---

<Card href={href} class={className}>
	<div class="equipment-card__media" slot="image">
		{
			item.data.image ? (
				<img
					src={item.data.image}
					alt=""
					loading="lazy"
					decoding="async"
					width="600"
					height="400"
				/>
			) : (
				<div class="equipment-card__placeholder" aria-hidden="true">
					<span class="equipment-card__placeholder-label">
						{item.data.imageSource === 'placeholder' ? 'Photo coming soon' : 'Image'}
					</span>
				</div>
			)
		}
	</div>
	{
		category && (
			<p class="equipment-card__category">{category.title}</p>
		)
	}
	<h3 class="equipment-card__title">{item.data.title}</h3>
	<p class="equipment-card__price">{priceLabel}</p>
	<p class="equipment-card__description">{item.data.description}</p>
</Card>

<style>
	.equipment-card__media {
		width: 100%;
	}

	.equipment-card__placeholder {
		aspect-ratio: 3 / 2;
		display: grid;
		place-items: center;
		background: linear-gradient(
			145deg,
			var(--color-surface-muted),
			var(--color-accent-subtle)
		);
	}

	.equipment-card__placeholder-label {
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-ink-subtle);
	}

	.equipment-card__category {
		margin: 0;
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-ink-muted);
	}

	.equipment-card__title {
		margin: 0;
		font-size: var(--text-xl);
		font-weight: var(--weight-semibold);
		letter-spacing: -0.02em;
	}

	.equipment-card__price {
		margin: 0;
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-accent);
	}

	.equipment-card__description {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-ink-muted);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
