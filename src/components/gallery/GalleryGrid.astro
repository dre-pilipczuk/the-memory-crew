---
/**
 * Gallery grid for lifestyle / event images.
 * Accepts items with src/alt or empty placeholders.
 */
import Gallery from '../common/Gallery.astro';

export type GalleryGridItem = {
	src?: string;
	alt: string;
	caption?: string;
};

interface Props {
	items: GalleryGridItem[];
	columns?: 2 | 3 | 4;
	class?: string;
}

const { items, columns = 3, class: className } = Astro.props;
---

<Gallery columns={columns} class={className}>
	{
		items.map((item) => (
			<figure class="gallery-grid__item">
				<div class="gallery-grid__frame">
					{item.src ? (
						<img
							src={item.src}
							alt={item.alt}
							loading="lazy"
							decoding="async"
							width="600"
							height="400"
						/>
					) : (
						<div class="gallery-grid__placeholder" aria-hidden="true" />
					)}
				</div>
				{item.caption && <figcaption class="gallery-grid__caption">{item.caption}</figcaption>}
			</figure>
		))
	}
</Gallery>

<style>
	.gallery-grid__item {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.gallery-grid__frame {
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background-color: var(--color-surface-muted);
		border: 1px solid var(--color-border);
	}

	.gallery-grid__frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.gallery-grid__placeholder {
		width: 100%;
		height: 100%;
		background: linear-gradient(
			145deg,
			var(--color-surface-muted),
			var(--color-border)
		);
	}

	.gallery-grid__caption {
		font-size: var(--text-sm);
		color: var(--color-ink-muted);
		padding-inline: var(--space-1);
	}
</style>
