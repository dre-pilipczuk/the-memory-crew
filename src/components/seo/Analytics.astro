---
/**
 * Site analytics — scripts only load when the matching env var is set.
 *
 * Plausible: PUBLIC_PLAUSIBLE_DOMAIN=thememorycrew.com
 * Cloudflare Web Analytics: PUBLIC_CF_BEACON_TOKEN=<token from CF dashboard>
 * Meta Pixel (Facebook/Instagram ads): PUBLIC_META_PIXEL_ID=<pixel id>
 */
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined;
const plausibleSrc =
	(import.meta.env.PUBLIC_PLAUSIBLE_SRC as string | undefined) ||
	'https://plausible.io/js/script.js';
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;

// Digits only — avoids injection and matches Meta Pixel ID format
const rawMetaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined;
const metaPixelId =
	rawMetaPixelId && /^\d{5,20}$/.test(rawMetaPixelId.trim())
		? rawMetaPixelId.trim()
		: undefined;

// Exact Cloudflare snippet shape (single-quoted JSON attribute)
const cfSnippet = cfBeacon
	? `<!-- Cloudflare Web Analytics --><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "${cfBeacon}"}'></script><!-- End Cloudflare Web Analytics -->`
	: '';

// Official Meta base code (literal pixel id — no define:vars IIFE wrapper)
const metaSnippet = metaPixelId
	? `<!-- Meta Pixel Code -->
<script>
!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '${metaPixelId}');
fbq('track', 'PageView');
</script>
<noscript><img height="1" width="1" style="display:none"
src="https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1"
alt=""/></noscript>
<!-- End Meta Pixel Code -->`
	: '';
---

{
	plausibleDomain && (
		<script
			defer
			data-domain={plausibleDomain}
			src={plausibleSrc}
			is:inline
		/>
	)
}

{cfBeacon && <Fragment set:html={cfSnippet} />}

{metaPixelId && <Fragment set:html={metaSnippet} />}
