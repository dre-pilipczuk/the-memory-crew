---
/**
 * Privacy-friendly analytics — no cookies, no consent banner required.
 *
 * Plausible: PUBLIC_PLAUSIBLE_DOMAIN=thememorycrew.com
 * Cloudflare Web Analytics: PUBLIC_CF_BEACON_TOKEN=<token from CF dashboard>
 *
 * Scripts only load when the matching env var is set.
 */
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined;
const plausibleSrc =
	(import.meta.env.PUBLIC_PLAUSIBLE_SRC as string | undefined) ||
	'https://plausible.io/js/script.js';
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;

// Exact Cloudflare snippet shape (single-quoted JSON attribute)
const cfSnippet = cfBeacon
	? `<!-- Cloudflare Web Analytics --><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "${cfBeacon}"}'></script><!-- End Cloudflare Web Analytics -->`
	: '';
---

{
	plausibleDomain && (
		<script
			defer
			data-domain={plausibleDomain}
			src={plausibleSrc}
			is:inline
		/>
	)
}

{cfBeacon && <Fragment set:html={cfSnippet} />}
