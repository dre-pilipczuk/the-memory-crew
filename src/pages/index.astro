---
import Layout from '../layouts/Layout.astro';
import Container from '../components/common/Container.astro';
import Section from '../components/common/Section.astro';
import Hero from '../components/common/Hero.astro';
import Button from '../components/common/Button.astro';
import SectionTitle from '../components/common/SectionTitle.astro';
import CTA from '../components/common/CTA.astro';
import EquipmentGrid from '../components/equipment/EquipmentGrid.astro';
import { Image } from 'astro:assets';
import { site } from '../config/site';
import { paths, withBase } from '../config/routes';
import { getFeaturedEquipment } from '../lib/content';
import heroImage from '../assets/lifestyle/hero-gathering.jpg';

const featured = await getFeaturedEquipment();
---

<Layout path="/" ogImage="/og-default.jpg">
	<Hero
		title={site.tagline}
		subtitle={site.description}
		eyebrow={site.name}
		size="full"
		hasMedia
	>
		<Image
			slot="media"
			src={heroImage}
			alt="Friends and family laughing together around giant garden games outdoors"
			widths={[800, 1200, 1600]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			formats={['avif', 'webp']}
		/>
		<Button variant="primary" size="lg" href={withBase(paths.contact)}>
			Get in touch
		</Button>
		<Button variant="secondary" size="lg" href={withBase(paths.hire)}>
			Browse hire
		</Button>
	</Hero>

	{
		featured.length > 0 && (
			<Section>
				<Container>
					<SectionTitle
						title="Popular hire"
						eyebrow="Featured"
						description="A taste of the kit that gets people of all ages playing and posing together."
					>
						<Button variant="link" href={withBase(paths.hire)}>
							View all hire
						</Button>
					</SectionTitle>
					<EquipmentGrid items={featured} />
				</Container>
			</Section>
		)
	}

	<Section muted>
		<Container width="content">
			<SectionTitle
				title="Equipment that brings everyone together"
				eyebrow={site.serviceAreaLabel}
				description="From garden games to photo booths, we hire the pieces that turn gatherings into memories — across South Wales and Bristol."
			/>
		</Container>
	</Section>

	<CTA
		title="Planning an event?"
		description="Share your date, postcode, and the kit you have in mind — we’ll help you put a day together."
		eyebrow={site.serviceAreaLabel}
	>
		<Button variant="primary" href={withBase(paths.contact)}>Contact us</Button>
		<Button variant="secondary" href={withBase(paths.occasions)}>Browse occasions</Button>
	</CTA>
</Layout>
