---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import Container from '../../components/common/Container.astro';
import Section from '../../components/common/Section.astro';
import Card from '../../components/common/Card.astro';
import SmartImage from '../../components/common/SmartImage.astro';
import CTA from '../../components/common/CTA.astro';
import Button from '../../components/common/Button.astro';
import { paths, withBase } from '../../config/routes';
import { getAllOccasions, occasionPath } from '../../lib/content';

const occasions = await getAllOccasions();
---

<Layout
	title="Occasions"
	description="Weddings, birthdays, corporate, schools, and Christmas — hire that fits the day."
	path={paths.occasions}
>
	<PageHeader
		title="Occasions"
		description="See how our equipment works for the kind of gathering you’re planning."
		eyebrow="Events"
	>
		<Breadcrumb
			slot="breadcrumb"
			items={[{ label: 'Home', href: paths.home }, { label: 'Occasions' }]}
		/>
	</PageHeader>

	<Section>
		<Container>
			<div class="occasion-grid">
				{
					occasions.map((occasion) => (
						<Card href={withBase(occasionPath(occasion))} class="reveal">
							<div slot="image">
								<SmartImage
									src={occasion.data.image}
									alt={occasion.data.title}
									sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw"
								/>
							</div>
							<h2 class="occasion-card__title">{occasion.data.title}</h2>
							<p class="occasion-card__body">{occasion.data.description}</p>
						</Card>
					))
				}
			</div>
		</Container>
	</Section>

	<CTA title="Tell us about your event">
		<Button variant="primary" href={withBase(paths.contact)}>Contact us</Button>
		<Button variant="secondary" href={withBase(paths.hire)}>Browse hire</Button>
	</CTA>
</Layout>

<style>
	.occasion-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
	}

	@media (min-width: 40rem) {
		.occasion-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.occasion-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.occasion-card__title {
		margin: 0;
		font-size: var(--text-xl);
	}

	.occasion-card__body {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-ink-muted);
	}
</style>
