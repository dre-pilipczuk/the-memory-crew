---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import Container from '../../components/common/Container.astro';
import Section from '../../components/common/Section.astro';
import SectionTitle from '../../components/common/SectionTitle.astro';
import Button from '../../components/common/Button.astro';
import EquipmentGrid from '../../components/equipment/EquipmentGrid.astro';
import CTA from '../../components/common/CTA.astro';
import { getCollection, render, getEntry } from 'astro:content';
import { getHireCategory } from '../../config/hire';
import { paths, withBase } from '../../config/routes';
import type { EquipmentEntry } from '../../lib/content';
import { occasionPath } from '../../lib/content';
import { breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
	const occasions = await getCollection('occasions', ({ data }) =>
		import.meta.env.PROD ? data.draft !== true : true,
	);

	return occasions.map((occasion) => ({
		params: { slug: occasion.id },
		props: { occasion },
	}));
}

const { occasion } = Astro.props;
const { Content } = await render(occasion);

const recommended: EquipmentEntry[] = (
	await Promise.all(
		occasion.data.recommendedEquipment.map((id) => getEntry('equipment', id)),
	)
).filter((entry): entry is EquipmentEntry => Boolean(entry) && entry.data.draft !== true);

const pagePath = occasionPath(occasion);
const crumbs = [
	{ label: 'Home', href: paths.home },
	{ label: 'Occasions', href: paths.occasions },
	{ label: occasion.data.title },
];
---

<Layout
	title={occasion.data.title}
	description={occasion.data.description}
	path={pagePath}
	jsonLd={breadcrumbJsonLd(crumbs)}
>
	<PageHeader
		title={occasion.data.title}
		description={occasion.data.description}
		eyebrow="Occasions"
	>
		<Breadcrumb slot="breadcrumb" items={crumbs} />
	</PageHeader>

	<Section>
		<Container width="content">
			<div class="occasion-body">
				<Content />
			</div>
			{
				occasion.data.recommendedCategories.length > 0 && (
					<div class="occasion-cats">
						<h2 class="occasion-cats__title">Popular categories</h2>
						<ul class="occasion-cats__list">
							{occasion.data.recommendedCategories.map((slug) => {
								const cat = getHireCategory(slug);
								return cat ? (
									<li>
										<a href={withBase(paths.hireCategory(cat.slug))}>{cat.title}</a>
									</li>
								) : null;
							})}
						</ul>
					</div>
				)
			}
		</Container>
	</Section>

	{
		recommended.length > 0 && (
			<Section muted>
				<Container>
					<SectionTitle
						title="Recommended hire"
						description={`Kit that works well for ${occasion.data.title.toLowerCase()}.`}
					/>
					<EquipmentGrid items={recommended} />
				</Container>
			</Section>
		)
	}

	<CTA title={`Planning ${occasion.data.title.toLowerCase()}?`}>
		<Button variant="primary" href={withBase(paths.contact)}>Enquire</Button>
		<Button variant="secondary" href={withBase(paths.hire)}>Browse all hire</Button>
	</CTA>
</Layout>

<style>
	.occasion-body :global(p) {
		margin: 0 0 var(--space-4);
		color: var(--color-ink-muted);
		max-width: 65ch;
	}

	.occasion-cats {
		margin-top: var(--space-7);
	}

	.occasion-cats__title {
		margin: 0 0 var(--space-3);
		font-size: var(--text-xl);
	}

	.occasion-cats__list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
	}

	.occasion-cats__list a {
		display: inline-flex;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-full);
		background: var(--color-accent-subtle);
		color: var(--color-accent-hover);
		text-decoration: none;
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}

	.occasion-cats__list a:hover {
		background: var(--color-accent);
		color: var(--color-accent-ink);
	}
</style>
