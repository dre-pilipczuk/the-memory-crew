---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/common/PageHeader.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import Container from '../components/common/Container.astro';
import Section from '../components/common/Section.astro';
import CTA from '../components/common/CTA.astro';
import Button from '../components/common/Button.astro';
import SmartImage from '../components/common/SmartImage.astro';
import { site } from '../config/site';
import { paths, withBase } from '../config/routes';
import aboutImage from '../assets/lifestyle/weddings-gathering.jpg';
---

<Layout
	title="About"
	description={`${site.name} — event hire across ${site.serviceAreaLabel}.`}
	path={paths.about}
>
	<PageHeader
		title="About us"
		description={site.tagline}
		eyebrow={site.name}
	>
		<Breadcrumb
			slot="breadcrumb"
			items={[{ label: 'Home', href: paths.home }, { label: 'About' }]}
		/>
	</PageHeader>

	<Section>
		<Container>
			<div class="about-layout">
				<div class="about-layout__media reveal">
					<SmartImage
						src={aboutImage}
						alt="Multi-generational wedding guests celebrating outdoors with garden games"
						priority
						sizes="(min-width: 48rem) 45vw, 100vw"
						widths={[600, 900, 1200]}
					/>
				</div>
				<div class="about">
					<p>
						{site.name} hires equipment that brings people of all ages together — so
						gatherings turn into memories that last for years.
					</p>
					<p>
						We’re building a carefully chosen fleet for events across{' '}
						<strong>{site.serviceAreaLabel}</strong>: photo booths, garden games, crazy
						golf, LED letters, dance floors, and more. We buy kit as bookings grow, so the
						catalogue stays honest and well looked after.
					</p>
					<p>
						Whether it’s a wedding, birthday, school fair, corporate day, or Christmas
						party, our job is simple: the right equipment, clearly priced, delivered with
						care.
					</p>
				</div>
			</div>
		</Container>
	</Section>

	<CTA title="Have a date in mind?">
		<Button variant="primary" href={withBase(paths.contact)}>Contact us</Button>
		<Button variant="secondary" href={withBase(paths.hire)}>See what we hire</Button>
	</CTA>
</Layout>

<style>
	.about-layout {
		display: grid;
		gap: var(--space-6);
		align-items: center;
	}

	@media (min-width: 48rem) {
		.about-layout {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-8);
		}
	}

	.about-layout__media {
		border-radius: var(--radius-xl);
		overflow: hidden;
		border: 1px solid var(--color-border);
	}

	.about {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.about p {
		margin: 0;
		color: var(--color-ink-muted);
		font-size: var(--text-lg);
		max-width: 65ch;
	}

	.about strong {
		color: var(--color-ink);
		font-weight: var(--weight-semibold);
	}
</style>
