---
/**
 * Internal design-system gallery — not linked in public navigation.
 * Review tokens and primitives here before building marketing pages.
 */
import Layout from '../layouts/Layout.astro';
import Container from '../components/common/Container.astro';
import Section from '../components/common/Section.astro';
import Button from '../components/common/Button.astro';
import Card from '../components/common/Card.astro';
import Hero from '../components/common/Hero.astro';
import PageHeader from '../components/common/PageHeader.astro';
import Gallery from '../components/common/Gallery.astro';
import Wordmark from '../components/common/Wordmark.astro';
import { site } from '../config/site';
import { hireCategories } from '../config/hire';
import { occasions } from '../config/occasions';
import { primaryNav, footerNav, isNavGroup } from '../config/navigation';
import { paths, withBase } from '../config/routes';

const swatches = [
	{ name: 'Canvas', token: '--color-canvas', value: '#FAF9F7' },
	{ name: 'Surface', token: '--color-surface', value: '#FFFFFF' },
	{ name: 'Surface muted', token: '--color-surface-muted', value: '#F3F1ED' },
	{ name: 'Ink', token: '--color-ink', value: '#1A1A1A' },
	{ name: 'Ink muted', token: '--color-ink-muted', value: '#5C5C5C' },
	{ name: 'Border', token: '--color-border', value: '#E8E4DE' },
	{ name: 'Accent', token: '--color-accent', value: '#D4645A' },
	{ name: 'Accent hover', token: '--color-accent-hover', value: '#B84F47' },
	{ name: 'Accent subtle', token: '--color-accent-subtle', value: '#F9EDEA' },
];

const typeSamples = [
	{ label: 'Display 5xl', className: 'type-5xl', sample: site.tagline },
	{ label: 'Display 3xl', className: 'type-3xl', sample: 'Page title' },
	{ label: 'Display 2xl', className: 'type-2xl', sample: 'Section title' },
	{ label: 'Body lg', className: 'type-lg', sample: site.description },
	{ label: 'Body base', className: 'type-base', sample: 'The quick brown fox jumps over the lazy dog.' },
	{ label: 'Caption sm', className: 'type-sm', sample: 'Meta · South Wales and Bristol · From £35' },
];

const galleryPlaceholders = [
	{ src: '', alt: 'Placeholder 1', caption: '3:2 placeholder' },
	{ src: '', alt: 'Placeholder 2', caption: 'Lifestyle slot' },
	{ src: '', alt: 'Placeholder 3', caption: 'Product slot' },
	{ src: '', alt: 'Placeholder 4', caption: 'Event slot' },
	{ src: '', alt: 'Placeholder 5', caption: 'Garden games' },
	{ src: '', alt: 'Placeholder 6', caption: 'Photo booth' },
];
---

<Layout title="Design system" description="Internal component and token gallery for The Memory Crew.">
	<header class="ds-chrome">
		<Container>
			<div class="ds-chrome__inner">
				<Wordmark size="sm" />
				<p class="ds-chrome__note">Design system · internal</p>
			</div>
		</Container>
	</header>

	<PageHeader
		title="Design system"
		eyebrow="Phase 1"
		description="Tokens and primitives for The Memory Crew. Not linked from public navigation."
	/>

	<Section>
		<Container>
			<div class="ds-block">
				<h2 class="ds-heading" id="colour">Colour</h2>
				<p class="ds-lede">Warm canvas, near-black ink, muted coral accent.</p>
				<div class="swatch-grid">
					{
						swatches.map((s) => (
							<div class="swatch">
								<div
									class="swatch__chip"
									style={`background-color: ${s.value}; ${s.name === 'Surface' || s.name === 'Canvas' || s.name === 'Accent subtle' ? 'border: 1px solid var(--color-border);' : ''}`}
								/>
								<p class="swatch__name">{s.name}</p>
								<p class="swatch__meta">{s.value}</p>
								<p class="swatch__meta">{s.token}</p>
							</div>
						))
					}
				</div>
			</div>
		</Container>
	</Section>

	<Section muted>
		<Container>
			<div class="ds-block">
				<h2 class="ds-heading" id="typography">Typography</h2>
				<p class="ds-lede">Inter throughout — same family for titles and body, distinguished by size and weight.</p>
				<div class="type-stack">
					{
						typeSamples.map((t) => (
							<div class="type-row">
								<span class="type-row__label">{t.label}</span>
								<span class:list={[t.className, t.className.startsWith('type-') && t.className.includes('xl') ? 'type-display' : '']}>
									{t.sample}
								</span>
							</div>
						))
					}
				</div>
			</div>
		</Container>
	</Section>

	<Section>
		<Container>
			<div class="ds-block">
				<h2 class="ds-heading" id="wordmark">Wordmark</h2>
				<p class="ds-lede">Typeset logo until a custom mark exists.</p>
				<div class="row gap">
					<Wordmark size="sm" href={false} />
					<Wordmark size="md" href={false} />
					<Wordmark size="lg" href={false} />
				</div>
			</div>
		</Container>
	</Section>

	<Section muted>
		<Container>
			<div class="ds-block">
				<h2 class="ds-heading" id="buttons">Buttons</h2>
				<p class="ds-lede">Primary, secondary, ghost, link — sm / md / lg.</p>
				<div class="row gap wrap">
					<Button variant="primary" size="sm">Primary sm</Button>
					<Button variant="primary" size="md">Primary md</Button>
					<Button variant="primary" size="lg">Primary lg</Button>
				</div>
				<div class="row gap wrap">
					<Button variant="secondary">Secondary</Button>
					<Button variant="ghost">Ghost</Button>
					<Button variant="link">Link button</Button>
					<Button variant="primary" disabled>Disabled</Button>
				</div>
				<div class="row gap wrap">
					<Button variant="primary" href={import.meta.env.BASE_URL}>As link</Button>
					<Button variant="secondary" href={import.meta.env.BASE_URL}>Secondary link</Button>
				</div>
			</div>
		</Container>
	</Section>

	<Section>
		<Container>
			<div class="ds-block">
				<h2 class="ds-heading" id="cards">Cards</h2>
				<p class="ds-lede">Surface, border, soft shadow — interactive lift optional.</p>
				<div class="card-grid">
					<Card>
						<h3 class="card-title">Garden Games</h3>
						<p class="card-meta">From £35</p>
						<p class="card-body">Giant Jenga, Connect 4, and more for all ages.</p>
					</Card>
					<Card href={import.meta.env.BASE_URL} interactive>
						<div class="card-image-placeholder" slot="image" />
						<h3 class="card-title">Photo Booth</h3>
						<p class="card-meta">Classic · Mirror</p>
						<p class="card-body">Interactive card with image slot (linked).</p>
					</Card>
					<Card>
						<div class="card-image-placeholder" slot="image" />
						<h3 class="card-title">LED Letters</h3>
						<p class="card-meta">Featured</p>
						<p class="card-body">Static card with image placeholder.</p>
					</Card>
				</div>
			</div>
		</Container>
	</Section>

	<Section muted>
		<Container>
			<div class="ds-block">
				<h2 class="ds-heading" id="gallery">Gallery</h2>
				<p class="ds-lede">3:2 frames, 2 → 3 columns. Empty frames until assets exist.</p>
				<Gallery columns={3}>
					{
						galleryPlaceholders.map((item) => (
							<figure class="gallery__item">
								<div class="gallery-ph" />
								{item.caption && <figcaption class="gallery-cap">{item.caption}</figcaption>}
							</figure>
						))
					}
				</Gallery>
			</div>
		</Container>
	</Section>

	{/* Hero demos outside muted bands for full-bleed feel */}
	<div class="ds-block ds-block--flush">
		<Container>
			<h2 class="ds-heading" id="hero">Hero</h2>
			<p class="ds-lede">Full and compact — no media yet (photography Phase 6).</p>
		</Container>
	</div>

	<Hero
		title="Bringing people together for memories that last"
		subtitle="Event hire across South Wales and Bristol."
		eyebrow="Hero · full"
		size="full"
	>
		<Button variant="primary" size="lg">Primary CTA</Button>
		<Button variant="secondary" size="lg">Secondary</Button>
	</Hero>

	<Hero
		title="Photo Booths"
		subtitle="Classic and mirror booths for weddings, parties, and corporate events."
		eyebrow="Hero · compact"
		size="compact"
	>
		<Button variant="primary">Enquire</Button>
	</Hero>

	<Section>
		<Container width="content">
			<div class="ds-block">
				<h2 class="ds-heading" id="page-header">Page header</h2>
				<p class="ds-lede">Shown above on this page. Quieter than Hero for inner routes.</p>
				<p class="ds-note">
					Spacing, radius, and shadow tokens live in <code>src/styles/tokens.css</code>.
					Brand copy lives in <code>src/config/site.ts</code>.
				</p>
			</div>
		</Container>
	</Section>

	<Section muted>
		<Container>
			<div class="ds-block">
				<h2 class="ds-heading" id="architecture">Site architecture (Phase 2)</h2>
				<p class="ds-lede">
					Taxonomies and nav from config — public pages land in Phase 5. Paths below are
					site-relative (base applied via <code>withBase()</code>).
				</p>

				<div class="arch-grid">
					<div>
						<h3 class="arch-title">Hire categories</h3>
						<ul class="arch-list">
							{
								hireCategories.map((c) => (
									<li>
										<span class="arch-label">{c.title}</span>
										<code class="arch-path">{paths.hireCategory(c.slug)}</code>
									</li>
								))
							}
						</ul>
						<p class="ds-note">
							Product example:{' '}
							<code class="arch-path">
								{paths.equipment('garden-games', 'giant-jenga')}
							</code>
						</p>
					</div>
					<div>
						<h3 class="arch-title">Occasions</h3>
						<ul class="arch-list">
							{
								occasions.map((o) => (
									<li>
										<span class="arch-label">{o.title}</span>
										<code class="arch-path">{paths.occasion(o.slug)}</code>
									</li>
								))
							}
						</ul>
					</div>
					<div>
						<h3 class="arch-title">Primary nav</h3>
						<ul class="arch-list">
							{
								primaryNav.map((item) => (
									<li>
										<span class="arch-label">{item.label}</span>
										<code class="arch-path">{item.href}</code>
										{isNavGroup(item) && (
											<span class="arch-meta">
												{item.children.length} children
											</span>
										)}
									</li>
								))
							}
						</ul>
						<p class="ds-note">
							Footer columns: {footerNav.map((c) => c.title).join(', ')}. Base-aware
							home href: <code class="arch-path">{withBase(paths.home)}</code>
						</p>
					</div>
				</div>

				<p class="ds-note">
					<a href={withBase(paths.home)}>← Back to home</a>
				</p>
			</div>
		</Container>
	</Section>
</Layout>

<style>
	.ds-chrome {
		padding-block: var(--space-4);
		border-bottom: 1px solid var(--color-border);
	}

	.ds-chrome__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.ds-chrome__note {
		font-size: var(--text-sm);
		color: var(--color-ink-muted);
		margin: 0;
	}

	.ds-block {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.ds-block--flush {
		padding-block: var(--space-7) var(--space-4);
	}

	.ds-heading {
		font-size: var(--text-2xl);
		margin: 0;
	}

	.ds-lede {
		color: var(--color-ink-muted);
		margin: 0;
		margin-block-start: calc(var(--space-2) * -1);
	}

	.ds-note {
		font-size: var(--text-sm);
		color: var(--color-ink-muted);
		margin: 0;
	}

	.ds-note code {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface-muted);
		padding: 0.1em 0.35em;
		border-radius: var(--radius-sm);
	}

	.swatch-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
		gap: var(--space-4);
	}

	.swatch__chip {
		aspect-ratio: 1;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
	}

	.swatch__name {
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		margin: var(--space-2) 0 0;
	}

	.swatch__meta {
		font-size: var(--text-xs);
		color: var(--color-ink-subtle);
		margin: 0;
		font-family: var(--font-mono);
		word-break: break-all;
	}

	.type-stack {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.type-row {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.type-row__label {
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-ink-subtle);
	}

	.type-display {
		font-family: var(--font-display);
		font-weight: var(--weight-semibold);
		letter-spacing: -0.02em;
		line-height: var(--leading-tight);
	}

	.type-5xl {
		font-family: var(--font-display);
		font-size: var(--text-5xl);
		font-weight: var(--weight-semibold);
		letter-spacing: -0.02em;
		line-height: var(--leading-tight);
	}

	.type-3xl {
		font-family: var(--font-display);
		font-size: var(--text-3xl);
		font-weight: var(--weight-semibold);
		letter-spacing: -0.02em;
		line-height: var(--leading-tight);
	}

	.type-2xl {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-semibold);
		letter-spacing: -0.02em;
		line-height: var(--leading-snug);
	}

	.type-lg {
		font-size: var(--text-lg);
		color: var(--color-ink-muted);
	}

	.type-base {
		font-size: var(--text-base);
	}

	.type-sm {
		font-size: var(--text-sm);
		color: var(--color-ink-muted);
	}

	.row {
		display: flex;
		align-items: center;
	}

	.gap {
		gap: var(--space-4);
	}

	.wrap {
		flex-wrap: wrap;
	}

	.card-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
	}

	@media (min-width: 40rem) {
		.card-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.card-title {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: var(--weight-semibold);
		margin: 0;
	}

	.card-meta {
		font-size: var(--text-sm);
		color: var(--color-accent);
		font-weight: var(--weight-medium);
		margin: 0;
	}

	.card-body {
		font-size: var(--text-sm);
		color: var(--color-ink-muted);
		margin: 0;
	}

	.card-image-placeholder {
		aspect-ratio: 3 / 2;
		width: 100%;
		background: linear-gradient(
			135deg,
			var(--color-surface-muted) 0%,
			var(--color-accent-subtle) 100%
		);
	}

	.gallery__item {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.gallery-ph {
		aspect-ratio: 3 / 2;
		border-radius: var(--radius-lg);
		background: linear-gradient(
			145deg,
			var(--color-surface-muted),
			var(--color-border)
		);
		border: 1px solid var(--color-border);
	}

	.gallery-cap {
		font-size: var(--text-sm);
		color: var(--color-ink-muted);
		padding-inline: var(--space-1);
	}

	.arch-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-7);
	}

	@media (min-width: 48rem) {
		.arch-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.arch-title {
		font-size: var(--text-lg);
		font-weight: var(--weight-semibold);
		margin: 0 0 var(--space-3);
	}

	.arch-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.arch-list li {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.arch-label {
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}

	.arch-path {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-ink-muted);
		background: var(--color-surface);
		padding: 0.15em 0.4em;
		border-radius: var(--radius-sm);
		border: 1px solid var(--color-border);
		width: fit-content;
		word-break: break-all;
	}

	.arch-meta {
		font-size: var(--text-xs);
		color: var(--color-ink-subtle);
	}
</style>
