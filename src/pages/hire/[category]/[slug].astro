---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/common/PageHeader.astro';
import Breadcrumb from '../../../components/common/Breadcrumb.astro';
import Container from '../../../components/common/Container.astro';
import Section from '../../../components/common/Section.astro';
import Button from '../../../components/common/Button.astro';
import PriceCard from '../../../components/equipment/PriceCard.astro';
import CTA from '../../../components/common/CTA.astro';
import SmartImage from '../../../components/common/SmartImage.astro';
import { getCollection, render } from 'astro:content';
import { getHireCategory } from '../../../config/hire';
import { paths, withBase } from '../../../config/routes';
import { equipmentPath } from '../../../lib/content';
import { breadcrumbJsonLd, equipmentJsonLd } from '../../../lib/seo';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
	const equipment = await getCollection('equipment', ({ data }) =>
		import.meta.env.PROD ? data.draft !== true : true,
	);

	return equipment.map((item) => ({
		params: { category: item.data.category, slug: item.id },
		props: { item },
	}));
}

const { item } = Astro.props;
const category = getHireCategory(item.data.category);
const { Content } = await render(item);
const pagePath = equipmentPath(item);

const crumbs = [
	{ label: 'Home', href: paths.home },
	{ label: 'Hire', href: paths.hire },
	...(category
		? [{ label: category.title, href: paths.hireCategory(category.slug) }]
		: []),
	{ label: item.data.title },
];

const ogImage = item.data.image
	? (await getImage({ src: item.data.image, width: 1200 })).src
	: undefined;
---

<Layout
	title={item.data.title}
	description={item.data.description}
	path={pagePath}
	ogImage={ogImage}
	jsonLd={[
		breadcrumbJsonLd(crumbs),
		equipmentJsonLd({
			name: item.data.title,
			description: item.data.description,
			path: pagePath,
			priceFrom: item.data.priceFrom,
			image: ogImage,
		}),
	]}
>
	<PageHeader
		title={item.data.title}
		description={item.data.description}
		eyebrow={category?.title ?? 'Hire'}
	>
		<Breadcrumb slot="breadcrumb" items={crumbs} />
	</PageHeader>

	<Section>
		<Container>
			<div class="product">
				<div class="product__media">
					<SmartImage
						src={item.data.image}
						alt={item.data.image ? item.data.title : ''}
						priority
						sizes="(min-width: 48rem) 55vw, 100vw"
						widths={[600, 900, 1200]}
					/>
				</div>

				<div class="product__sidebar">
					<PriceCard priceFrom={item.data.priceFrom}>
						<Button
							variant="primary"
							href={`${withBase(paths.contact)}?equipment=${item.data.category}`}
						>
							Enquire about this item
						</Button>
						<Button variant="secondary" href={withBase(paths.hire)}>
							Browse more hire
						</Button>
					</PriceCard>
				</div>

				<div class="product__body">
					{
						item.data.whatsIncluded.length > 0 && (
							<div class="product__included">
								<h2 class="product__subheading">What’s included</h2>
								<ul>
									{item.data.whatsIncluded.map((line) => (
										<li>{line}</li>
									))}
								</ul>
							</div>
						)
					}
					<div class="product__content">
						<Content />
					</div>
				</div>
			</div>
		</Container>
	</Section>

	<CTA
		title="Ready to check a date?"
		description="Share your event details and we’ll confirm availability across South Wales and Bristol."
	>
		<Button variant="primary" href={withBase(paths.contact)}>Contact us</Button>
		{
			category && (
				<Button
					variant="secondary"
					href={withBase(paths.hireCategory(category.slug))}
				>
					More {category.title.toLowerCase()}
				</Button>
			)
		}
	</CTA>
</Layout>

<style>
	.product {
		display: grid;
		gap: var(--space-6);
	}

	@media (min-width: 48rem) {
		.product {
			grid-template-columns: 1.4fr 1fr;
			grid-template-areas:
				'media sidebar'
				'body sidebar';
			align-items: start;
			gap: var(--space-7);
		}

		.product__media {
			grid-area: media;
		}

		.product__sidebar {
			grid-area: sidebar;
			position: sticky;
			top: 6rem;
		}

		.product__body {
			grid-area: body;
		}
	}

	.product__media {
		border-radius: var(--radius-xl);
		overflow: hidden;
		border: 1px solid var(--color-border);
		background: var(--color-surface-muted);
	}

	.product__subheading {
		margin: 0 0 var(--space-3);
		font-size: var(--text-xl);
	}

	.product__included ul {
		margin: 0 0 var(--space-6);
		padding-left: 1.2rem;
		color: var(--color-ink-muted);
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.product__content :global(p) {
		margin: 0 0 var(--space-4);
		color: var(--color-ink-muted);
		max-width: 65ch;
	}

	.product__content :global(p:last-child) {
		margin-bottom: 0;
	}
</style>
