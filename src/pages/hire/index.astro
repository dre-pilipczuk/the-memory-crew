---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import Container from '../../components/common/Container.astro';
import Section from '../../components/common/Section.astro';
import SectionTitle from '../../components/common/SectionTitle.astro';
import Card from '../../components/common/Card.astro';
import EquipmentGrid from '../../components/equipment/EquipmentGrid.astro';
import SmartImage from '../../components/common/SmartImage.astro';
import CTA from '../../components/common/CTA.astro';
import Button from '../../components/common/Button.astro';
import { hireCategories } from '../../config/hire';
import { paths, withBase } from '../../config/routes';
import { getAllEquipment } from '../../lib/content';

const equipment = await getAllEquipment();

const categoryImage = Object.fromEntries(
	hireCategories.map((category) => {
		const match = equipment.find((item) => item.data.category === category.slug);
		return [category.slug, match?.data.image];
	}),
);
---

<Layout
	title="Hire"
	description="Event hire across South Wales and Bristol — photo booths, garden games, LED letters, and more."
	path={paths.hire}
>
	<PageHeader
		title="Hire"
		description="Browse equipment by category. Prices shown are guides — we’ll confirm a full quote for your date and postcode."
		eyebrow="Equipment"
	>
		<Breadcrumb
			slot="breadcrumb"
			items={[{ label: 'Home', href: paths.home }, { label: 'Hire' }]}
		/>
	</PageHeader>

	<Section>
		<Container>
			<SectionTitle
				title="Categories"
				description="Pick a type of kit, or scroll for everything we list so far."
			/>
			<div class="category-grid">
				{
					hireCategories.map((category) => (
						<Card href={withBase(paths.hireCategory(category.slug))} class="reveal">
							<div slot="image">
								<SmartImage
									src={categoryImage[category.slug]}
									alt={category.title}
									sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw"
								/>
							</div>
							<h2 class="category-card__title">{category.title}</h2>
							<p class="category-card__body">{category.description}</p>
						</Card>
					))
				}
			</div>
		</Container>
	</Section>

	<Section muted>
		<Container>
			<SectionTitle title="All equipment" description="Growing as we add kit to the fleet." />
			<EquipmentGrid items={equipment} />
		</Container>
	</Section>

	<CTA
		title="Not sure what you need?"
		description="Tell us about the occasion — we’ll suggest a simple package."
	>
		<Button variant="primary" href={withBase(paths.contact)}>Get in touch</Button>
	</CTA>
</Layout>

<style>
	.category-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}

	@media (min-width: 40rem) {
		.category-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.category-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.category-card__title {
		margin: 0;
		font-size: var(--text-xl);
	}

	.category-card__body {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-ink-muted);
	}
</style>
