---
import '../styles/global.css';
import { site } from '../config/site';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Seo from '../components/seo/Seo.astro';
import Analytics from '../components/seo/Analytics.astro';
import { localBusinessJsonLd } from '../lib/seo';

interface Props {
	title?: string;
	description?: string;
	/** Site path without base (for canonical/OG), e.g. /hire */
	path?: string;
	/** Hide site chrome */
	chrome?: boolean;
	noindex?: boolean;
	ogImage?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** Include LocalBusiness JSON-LD (home by default when path is /) */
	includeLocalBusiness?: boolean;
	/** Optional body class (campaign pages) */
	bodyClass?: string;
	themeColor?: string;
}

const {
	title,
	description = site.description,
	path = '/',
	chrome = true,
	noindex = false,
	ogImage,
	jsonLd,
	includeLocalBusiness = path === '/' || path === '',
	bodyClass,
	themeColor = '#FAF9F7',
} = Astro.props;

const blocks = [
	...(includeLocalBusiness ? [localBusinessJsonLd()] : []),
	...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content={themeColor} />
		<Seo
			title={title}
			description={description}
			path={path}
			ogImage={ogImage}
			noindex={noindex}
			jsonLd={blocks.length ? blocks : undefined}
		/>
		{/* Privacy-friendly analytics — skipped when env vars unset / on noindex pages */}
		{!noindex && <Analytics />}
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<a class="skip-link" href="#main">Skip to content</a>
		{chrome && <Navbar />}
		<main id="main">
			<slot />
		</main>
		{chrome && <Footer />}
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	main {
		flex: 1;
	}

	:global(body.nav-open) {
		overflow: hidden;
	}

	@media (min-width: 64rem) {
		:global(body.nav-open) {
			overflow: auto;
		}
	}
</style>
