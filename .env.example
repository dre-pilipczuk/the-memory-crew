# Formspree form id (from https://formspree.io — the part after /f/)
# Example: if your endpoint is https://formspree.io/f/xyzabcde then:
PUBLIC_FORMSPREE_ID=xyzabcde

# --- Analytics (optional; privacy-friendly, no cookie banner) ---
# Plausible: https://plausible.io — use your site domain as registered there
# PUBLIC_PLAUSIBLE_DOMAIN=thememorycrew.com
# Optional self-hosted script URL:
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Cloudflare Web Analytics (free): token from CF dashboard → Web Analytics
# PUBLIC_CF_BEACON_TOKEN=

# Meta Pixel (Facebook/Instagram ads) — site-wide PageView; Lead on form submits
# PUBLIC_META_PIXEL_ID=
